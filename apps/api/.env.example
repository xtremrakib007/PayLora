# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrsaas

# Auth — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=3000
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173
# Public URLs (used for invite links, Billplz redirects and callbacks)
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# Billplz (https://www.billplz.com). Leave BILLPLZ_API_KEY empty to disable checkout.
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_SANDBOX=true
# Local development only: activate paid plans instantly without a payment provider
BILLING_DEV_MODE=false

# Seed: platform super-admin account
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=ChangeMe123!
